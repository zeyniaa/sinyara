# Copy to .env. Never commit secrets. Restart backend after editing.
SINYARA_LLM_PROVIDER=ollama
SINYARA_OLLAMA_URL=http://127.0.0.1:11434
SINYARA_LLM_MODEL=qwen3:4b
SINYARA_LLM_TIMEOUT=180
SINYARA_ASR_PROVIDER=whisper
# For isolated Qwen-ASR on an eligible Space: SINYARA_ASR_PROVIDER=qwen-remote
SINYARA_ASR_SPACE=
SINYARA_WHISPER_MODEL=small
SINYARA_AASIST_ENABLED=false
SINYARA_AASIST_DIR=.cache/aasist
SINYARA_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4174
# Keep local model caches out of your source archive.
HF_HOME=.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
GRADIO_ANALYTICS_ENABLED=False
